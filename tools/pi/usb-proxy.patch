diff --git a/device-libusb.cpp b/device-libusb.cpp
index c8fe927..a901c66 100644
--- a/device-libusb.cpp
+++ b/device-libusb.cpp
@@ -465,7 +465,8 @@ int receive_data(uint8_t endpoint, uint8_t attributes, uint16_t maxPacketSize,
 		break;
 	}
 
-	if (result != LIBUSB_SUCCESS) {
+	// An idle endpoint times out once a second. That is not an error.
+	if (result != LIBUSB_SUCCESS && result != LIBUSB_ERROR_TIMEOUT) {
 		fprintf(stderr, "Transfer error receiving on EP%02x: %s\n",
 				endpoint, libusb_strerror((libusb_error)result));
 	}
diff --git a/proxy.cpp b/proxy.cpp
index bafa47e..f0f5c3b 100644
--- a/proxy.cpp
+++ b/proxy.cpp
@@ -859,7 +859,9 @@ void *ep_loop_read(void *arg) {
 					break;
 				}
 
-				if (nbytes >= 0) {
+				// A timeout leaves nbytes at 0. Forwarding that would send the
+				// host a zero-length report the device never sent.
+				if (rv == LIBUSB_SUCCESS || nbytes > 0) {
 					memcpy(io.data, data, nbytes);
 					io.inner.ep = ep_num;
 					io.inner.flags = 0;
@@ -887,7 +889,11 @@ void *ep_loop_read(void *arg) {
 			// Passing a larger buffer (e.g. 4096) causes musb-hdrc to report
 			// req->actual = req->length instead of the real frame size, which
 			// then triggers EMSGSIZE (-90) when forwarding to the physical device.
-			if ((ep.bmAttributes & USB_ENDPOINT_XFERTYPE_MASK) == USB_ENDPOINT_XFER_ISOC)
+			// Interrupt OUT too: a full-size packet does not end a larger
+			// request, so the UDC would hold a report of exactly
+			// wMaxPacketSize until more data came.
+			if ((ep.bmAttributes & USB_ENDPOINT_XFERTYPE_MASK) == USB_ENDPOINT_XFER_ISOC ||
+			    (ep.bmAttributes & USB_ENDPOINT_XFERTYPE_MASK) == USB_ENDPOINT_XFER_INT)
 				io.inner.length = usb_endpoint_maxp(&ep);
 			else
 				io.inner.length = sizeof(io.data);
diff --git a/usb-proxy.cpp b/usb-proxy.cpp
index f2fdaac..69a47db 100644
--- a/usb-proxy.cpp
+++ b/usb-proxy.cpp
@@ -652,10 +652,8 @@ int main(int argc, char **argv)
 	if (context && callback_handle != -1) {
 		libusb_hotplug_deregister_callback(context, callback_handle);
 	}
-	if (hotplug_monitor_thread &&
-		pthread_join(hotplug_monitor_thread, NULL)) {
-		fprintf(stderr, "Error join hotplug_monitor_thread\n");
-	}
+	// hotplug_monitor loops forever, so joining it would hang the exit
+	// after every unplug. Returning from main ends it.
 
 	return 0;
 }
