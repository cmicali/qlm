[Unit]
Description=qlm inline USB proxy for the GLM adapter
After=systemd-modules-load.service
# Restart forever. Each unplug ends usb-proxy, and the default limit would
# leave the unit failed after a few.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/bin/qlm-proxy
Restart=always
RestartSec=1
# usb-proxy waits in a blocking ioctl and misses SIGTERM while the Mac is
# quiet. It keeps no state, so a quick SIGKILL is safe.
TimeoutStopSec=3

[Install]
WantedBy=multi-user.target
